# ==============================================================================
# StreamClick Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME=StreamClick
LOG_LEVEL=INFO

# Ingestion API (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Message Broker (Redpanda / Kafka)
BROKER_TYPE=kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_CLICKSTREAM=events.clickstream.raw
KAFKA_CONSUMER_GROUP=streamclick-consumer-group

# Data Lake Storage (MinIO / S3)
STORAGE_TYPE=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=clickstream-lake
S3_REGION_NAME=us-east-1
S3_SECURE=false

# Speed Layer / Serving Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=streamclick
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret_pw

# Future Cloud Migration Stubs (GCP)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_PUBSUB_TOPIC=clickstream-raw-topic
# GCP_GCS_BUCKET=your-gcp-clickstream-lake
