# ==============================================================================
# StreamClick Environment Configuration (.env.example)
# ==============================================================================

# Application & Environment
APP_ENV=
APP_NAME=
LOG_LEVEL=

# Ingestion API (FastAPI)
API_HOST=
API_PORT=

# Message Broker (Redpanda / Kafka)
BROKER_TYPE=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_CLICKSTREAM=
KAFKA_CONSUMER_GROUP=

# Data Lake Storage (MinIO / S3)
STORAGE_TYPE=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION_NAME=
S3_SECURE=

# Speed Layer / Serving Database (PostgreSQL)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Future Cloud Migration Stubs (GCP)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_PUBSUB_TOPIC=clickstream-raw-topic
# GCP_GCS_BUCKET=your-gcp-clickstream-lake
